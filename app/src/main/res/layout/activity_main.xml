<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ CIDZ BRIDGE"
            android:textColor="#58A6FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Background DANA Notification Listener"
            android:textColor="#8B949E"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#30363D" />

        <TextView
            android:id="@+id/tvPermissionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status Izin Notifikasi: Mengecek..."
            android:textColor="#E6EDF3"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#238636"
            android:text="Aktifkan Akses Notifikasi"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#21262D"
            android:text="Matikan Optimasi Baterai (Agar Awet 24/7)"
            android:textColor="#C9D1D9" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Target Webhook URL"
            android:textColor="#C9D1D9"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#161B22"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Forwarder Secret Key (X-Forwarder-Key)"
            android:textColor="#C9D1D9"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#161B22"
            android:hint="Opsional / Samakan dengan admin PG"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#484F58"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1F6FEB"
            android:text="Simpan Konfigurasi"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#30363D"
            android:text="Kirim Test Notifikasi ke PG"
            android:textColor="#C9D1D9" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Status: Idle"
            android:textColor="#8B949E"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
